{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nest-base-project/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nest-base-project/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nest-base-project",
  "projects": {
    "nest-base-project": {
      "type": "application",
      "root": "apps/nest-base-project",
      "entryFile": "main",
      "sourceRoot": "apps/nest-base-project/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nest-base-project/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    }
  }
}
